{
  "name": "@webship.co/workspace-drupal-themes",
  "version": "1.0.12",
  "description": "The Drupal themes workspace for Webship Workspace: the `themes/` folder (type code), its settings file, its 15 commands, its docs and its AI items (an agent, a skill, a command and a prompt, each in the folder of its kind), activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-drupal-themes.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "docs",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "drupal-themes",
    "label": "Drupal themes",
    "needs": [
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "suggests": {
      "commands": [
        {
          "command": "composer",
          "hint": "https://getcomposer.org/download/"
        }
      ]
    },
    "workspace": {
      "key": "themes",
      "settingsTemplate": "config/workspace.themes.settings.yml",
      "files": [
        "commands/cmd-all-back-end-build-themes.sh",
        "commands/cmd-all-back-end-install-themes.sh",
        "commands/cmd-all-front-end-build-themes.sh",
        "commands/cmd-all-front-end-install-themes.sh",
        "commands/cmd-backup-theme.sh",
        "commands/cmd-build-admin-theme.sh",
        "commands/cmd-build-drupal-template.sh",
        "commands/cmd-build-theme.sh",
        "commands/cmd-install-admin-theme.sh",
        "commands/cmd-install-theme.sh",
        "commands/cmd-tools-checks.sh",
        "commands/cmd-tools-gitlab-ci-local.sh",
        "commands/cmd-tools-reclaim.sh",
        "commands/cmd-tools-remove.sh",
        "commands/cmd-tools-update-all.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/themes-maintainer.md"
      ],
      "skills": [
        "ai/skills/themes-workflow"
      ],
      "commands": [
        "ai/commands/themes-check.md"
      ],
      "prompts": [
        "ai/prompts/themes-green-gate.md"
      ]
    },
    "features": [
      "features/drupal-themes.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
